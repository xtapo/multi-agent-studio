// ---------------------------------------------------------------------------
// Multi-Agent Studio — data model
//
// Design notes:
//  * Workspace is the tenancy boundary. Every agent, workflow and run belongs
//    to exactly one workspace, which makes authorization a single join.
//  * Agent config that the runtime reads is stored as typed columns where it is
//    queried (model, temperature) and as Json where it is only ever read as a
//    whole (tools, outputSchema, memoryConfig). This keeps the schema stable
//    while the agent feature set evolves.
//  * RunEvent is an append-only log. The SSE endpoint pages through it by
//    monotonically increasing `seq`, so a client can reconnect and replay
//    without any in-memory state on the server. This is what makes the
//    execution viewer survive redeploys and multiple server instances.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- Auth.js -----------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships WorkspaceMember[]
  runs        WorkflowRun[]
  memories    Memory[]
  apiKeys     ProviderApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------ Tenancy ------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  agents    Agent[]
  workflows Workflow[]
  runs      WorkflowRun[]
  tools     ToolDefinition[]
  memories  Memory[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ------------------------------- Agents ------------------------------------

enum OutputFormat {
  TEXT
  MARKDOWN
  JSON
}

model Agent {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  /// One-line statement of what this agent is responsible for. Injected into
  /// the system prompt and shown to the supervisor/router when delegating.
  role         String
  systemPrompt String @db.Text

  /// Canonical model id, e.g. "openai:gpt-4o-mini". The provider registry
  /// resolves the prefix, so the agent never knows which vendor it runs on.
  model       String  @default("openai:gpt-4o-mini")
  temperature Float   @default(0.3)
  maxTokens   Int     @default(2048)

  outputFormat OutputFormat @default(TEXT)
  /// JSON Schema object used for structured output + validation + repair loop.
  outputSchema Json?

  /// ToolConfig[] — { toolName, enabled, maxCalls?, config? }
  tools Json @default("[]")

  /// MemoryConfig — { shortTerm, workflowMemory, userMemory, maxItems }
  memoryConfig Json?

  /// { maxRetries, backoffMs }
  retryConfig Json?

  isTemplate Boolean @default(false)
  archived   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     WorkflowNode[]
  agentRuns AgentRun[]

  @@index([workspaceId, archived])
  @@index([workspaceId, name])
}

// ------------------------------ Workflows ----------------------------------

enum ExecutionMode {
  SEQUENTIAL
  PARALLEL
  SUPERVISOR
  ROUTER
  DEBATE
}

model Workflow {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  executionMode ExecutionMode @default(SEQUENTIAL)

  entryNodeId String?
  finalNodeId String?

  /// Per-workflow guardrail overrides — see RunBudget in src/types/run.ts.
  budget Json?

  isTemplate  Boolean @default(false)
  templateKey String? @unique
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     WorkflowNode[]
  edges     WorkflowEdge[]
  runs      WorkflowRun[]
  memories  Memory[]

  @@index([workspaceId, archived])
}

enum NodeKind {
  AGENT
  START
  END
}

model WorkflowNode {
  id         String   @id @default(cuid())
  workflowId String
  agentId    String?
  kind       NodeKind @default(AGENT)

  /// Display label, defaults to the agent name but can be overridden so the
  /// same agent can appear twice with different roles in one graph.
  label String?

  positionX Float @default(0)
  positionY Float @default(0)

  /// ContextPolicy — controls exactly what this node receives as input.
  /// { includeOriginalTask, includeUpstreamOutputs, includeVariables[],
  ///   includeSharedNotes, extraInstructions }
  contextPolicy Json?

  /// Free-form per-node config: debate role, router branch key, etc.
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow  Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agent     Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  outgoing  WorkflowEdge[] @relation("EdgeSource")
  incoming  WorkflowEdge[] @relation("EdgeTarget")
  agentRuns AgentRun[]

  @@index([workflowId])
}

model WorkflowEdge {
  id           String  @id @default(cuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  label        String?

  /// Optional routing condition, e.g. { route: "research" } for router mode.
  condition Json?

  createdAt DateTime @default(now())

  workflow Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  source   WorkflowNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target   WorkflowNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([workflowId])
}

// -------------------------------- Runs -------------------------------------

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowRun {
  id          String @id @default(cuid())
  workspaceId String
  workflowId  String
  triggeredById String?

  input  String  @db.Text
  output String? @db.Text

  status RunStatus @default(QUEUED)
  error  String?   @db.Text

  /// Terminal snapshot of the shared AgentState, for replay and debugging.
  finalState Json?

  inputTokens   Int   @default(0)
  outputTokens  Int   @default(0)
  totalTokens   Int   @default(0)
  estimatedCost Float @default(0)
  stepCount     Int   @default(0)
  toolCallCount Int   @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredBy User?      @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  steps       AgentRun[]
  events      RunEvent[]

  @@index([workflowId, startedAt])
  @@index([workspaceId, startedAt])
  @@index([status])
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model AgentRun {
  id     String @id @default(cuid())
  runId  String
  nodeId String?
  agentId String?

  /// Position in the execution timeline (0-based, monotonic per run).
  stepIndex  Int
  agentName  String
  status     StepStatus @default(PENDING)

  /// Rendered task handed to this agent (already context-filtered).
  input String? @db.Text
  /// The resolved system prompt. Stored for observability, not chain-of-thought.
  prompt String? @db.Text

  outputText String? @db.Text
  outputJson Json?

  /// Short, user-facing "what I did and why" summary produced by the agent.
  /// Deliberately NOT private chain-of-thought.
  reasoningSummary String? @db.Text

  /// ToolCallRecord[] — { name, input, output, error, durationMs, startedAt }
  toolCalls Json @default("[]")

  model         String?
  inputTokens   Int    @default(0)
  outputTokens  Int    @default(0)
  estimatedCost Float  @default(0)
  retryCount    Int    @default(0)

  error     String? @db.Text
  errorCode String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  run   WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  node  WorkflowNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  agent Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([runId, stepIndex])
  @@index([agentId])
}

/// Append-only event log. The SSE endpoint is a thin cursor over this table.
model RunEvent {
  id    String @id @default(cuid())
  runId String
  seq   Int

  type    String
  payload Json

  createdAt DateTime @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
}

// -------------------------------- Tools ------------------------------------

/// Persisted metadata / per-workspace enablement for tools. The executable
/// implementation always lives in code (src/lib/tools/builtin); this table only
/// stores whether a workspace has turned it on and any workspace-level config.
model ToolDefinition {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  displayName String
  description String  @db.Text
  inputSchema Json
  enabled     Boolean @default(true)
  /// Marks tools that can mutate external state or execute code.
  dangerous   Boolean @default(false)
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// ------------------------------- Memory ------------------------------------

enum MemoryScope {
  SHORT_TERM
  WORKFLOW
  USER
}

model Memory {
  id          String      @id @default(cuid())
  workspaceId String
  scope       MemoryScope

  workflowId String?
  userId     String?
  runId      String?
  agentKey   String?

  key     String
  value   Json
  /// Higher = kept longer when the memory store prunes.
  weight  Float    @default(1)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
  @@index([workflowId, scope])
  @@index([userId, scope])
  @@index([runId])
}

// --------------------------- Secret management -----------------------------

/// User-supplied provider keys. `ciphertext` is AES-256-GCM, encrypted with
/// ENCRYPTION_KEY before it ever reaches Postgres. Never selected into any
/// payload that crosses the network boundary to the browser.
model ProviderApiKey {
  id       String @id @default(cuid())
  userId   String
  provider String
  label    String?

  ciphertext String @db.Text
  iv         String
  authTag    String
  last4      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
  @@index([userId])
}
