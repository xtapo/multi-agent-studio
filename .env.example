# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Change if you point at a managed Postgres.
DATABASE_URL="postgresql://mas:mas@localhost:5433/multi_agent_studio?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Secret management
# ---------------------------------------------------------------------------
# 32-byte key, base64 encoded. Used for AES-256-GCM encryption of user-supplied
# provider API keys before they touch the database.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-base64-32-byte-key"

# ---------------------------------------------------------------------------
# LLM providers (server-side only, never exposed to the browser)
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# Optional: point at a compatible gateway (Azure OpenAI, LiteLLM, Ollama, ...)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional, for the (stubbed) Anthropic provider
# ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# Optional: enables the real web_search tool. Without it the tool returns a
# clearly-labelled "search unavailable" result instead of hallucinating.
# TAVILY_API_KEY="tvly-..."

# Comma separated allowlist of hosts the http_request tool may reach.
# Empty means "deny everything except public HTTPS, SSRF guard still applies".
HTTP_TOOL_ALLOWED_HOSTS=""

# ---------------------------------------------------------------------------
# Global guardrails (per workflow run). Can be overridden per workflow.
# ---------------------------------------------------------------------------
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MAX_RUN_TOKENS=200000
MAX_RUN_COST_USD=2
RUN_TIMEOUT_MS=600000
