# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local
# Postgres already using 5432).
DATABASE_URL="postgresql://mas:mas@localhost:5433/multi_agent_studio?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# AES-256-GCM key used to encrypt user-supplied provider keys at rest.
# openssl rand -base64 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Model providers  (never exposed to the browser)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
# Optional: Azure OpenAI or an OpenAI-compatible gateway
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional: enables Claude models
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Custom / local model  (Ollama, LM Studio, vLLM, LiteLLM, OpenRouter, ...)
# ---------------------------------------------------------------------------
# Anything that speaks the OpenAI chat-completions dialect. Models appear in
# the Agent Builder with a "custom:" prefix and can be mixed with OpenAI models
# inside the same workflow. Full guide: docs/custom-models.md
#
# Ollama example:
#   CUSTOM_LLM_BASE_URL="http://localhost:11434/v1"
#   CUSTOM_LLM_API_KEY="ollama"
#   CUSTOM_LLM_NAME="Ollama (local)"
#   CUSTOM_LLM_MODELS="qwen2.5:14b=Qwen2.5 14B,llama3.1:8b=Llama 3.1 8B"
#
# OpenRouter example:
#   CUSTOM_LLM_BASE_URL="https://openrouter.ai/api/v1"
#   CUSTOM_LLM_API_KEY="sk-or-..."
#   CUSTOM_LLM_NAME="OpenRouter"
#   CUSTOM_LLM_MODELS="deepseek/deepseek-chat=DeepSeek V3"
#   CUSTOM_LLM_INPUT_COST=0.27
#   CUSTOM_LLM_OUTPUT_COST=1.1
CUSTOM_LLM_BASE_URL=""
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_NAME=""
CUSTOM_LLM_MODELS=""
CUSTOM_LLM_CONTEXT_WINDOW="32000"
# Set to false for small models that cannot do function calling.
CUSTOM_LLM_SUPPORTS_TOOLS="true"
# USD per 1M tokens. Leave at 0 for local models so the cost guardrail ignores them.
CUSTOM_LLM_INPUT_COST="0"
CUSTOM_LLM_OUTPUT_COST="0"

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# Optional: real web search. Without it the web_search tool degrades gracefully.
TAVILY_API_KEY=""
# Comma-separated allowlist for the http_request tool (SSRF protection).
# Empty means the tool refuses every host.
HTTP_TOOL_ALLOWED_HOSTS="api.github.com,jsonplaceholder.typicode.com"

# ---------------------------------------------------------------------------
# Guardrails applied to every run (a run may tighten, never loosen, these)
# ---------------------------------------------------------------------------
MAX_AGENT_STEPS="20"
MAX_TOOL_CALLS="40"
MAX_RUN_TOKENS="200000"
MAX_RUN_COST_USD="2"
RUN_TIMEOUT_MS="600000"

# ---------------------------------------------------------------------------
# Durable runs  (see docs/durable-runs.md)
# ---------------------------------------------------------------------------
# false = the web process executes runs itself (fine for local dev, but a
#         restart loses any run in flight).
# true  = runs are pushed to a pg-boss queue and executed by `npm run worker`,
#         so deploys and crashes no longer lose work. Recommended in production.
RUN_QUEUE_ENABLED="false"
# How many runs a single worker process executes concurrently.
RUN_WORKER_CONCURRENCY="2"
# A RUNNING run with no new event for this long is treated as interrupted and
# closed as failed by the worker's recovery sweep.
RUN_STALE_AFTER_MS="900000"
# How often an executing run checks whether it was cancelled from the web tier.
RUN_CANCEL_POLL_MS="3000"
